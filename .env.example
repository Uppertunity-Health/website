# Secret settings this site needs on Vercel (Project → Settings → Environment Variables).
# Names only — never put real values in this file.
# Re-enter each one in the client's Vercel account at handover.

# Website forms (api/forms.mjs). Until RESEND_API_KEY is set, forms are accepted but not emailed.
RESEND_API_KEY=      # key from the Resend account opened in the client's name (uppertunity.health verified)
FORMS_TO=            # info@uppertunity.health
FORMS_FROM=          # Uppertunity Health Website <website@uppertunity.health>
